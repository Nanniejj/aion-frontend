<template>
    <div class="py-3 mt-3">
        <!-- header: ชื่อหัวข้อ (ซ้าย) + โควตา & ปุ่มเพิ่ม (ขวา) -->
        <div class="priority-header mb-3">
            <div class="text-left">
                <!-- <b-avatar size="40" style="background-color: #fed16e; color:#4c412d;">
                    <i class="fas fa-bolt"></i>
                </b-avatar> -->
                <div class="ml-3">
                    <div class="bold" style="font-size: 20px; line-height: 1.1;">เป้าหมายพิเศษ</div>
                    <small class="text-muted">เก็บข้อมูลแบบพิเศษ (เฝ้าระวังเข้มข้น)</small>
                </div>
            </div>
            <div class="priority-header-actions d-flex align-items-center">
                <span class="quota-pill" :class="{ full: totalRows >= maxTargets }">
                    <i class="fas fa-users mr-1"></i>
                    {{ totalRows }} / {{ maxTargets }} บัญชี
                </span>
                <!-- ฟอร์มเดียวกับเพิ่มเป้าหมายปกติ (validate/preview เหมือนกัน) ต่างแค่ mode priority -->
                <CreateMonitor
                    v-if="totalRows < maxTargets"
                    class="pf-add"
                    tabsMonitor="targetlist"
                    mode="priority"
                    :maxTargets="remainingQuota"
                    @close="onAdded"
                />
                <button v-else class="btn btn-add-priority" disabled>
                    <i class="fa fa-plus mr-1" /> เต็มโควตาแล้ว ({{ maxTargets }})
                </button>
            </div>
        </div>

        <!-- filters (เหมือนหน้า Profile ปกติ) -->
        <div class="priority-filters mb-3">
            <div class="pf-source-icon">
                <img v-if="sourceImg(filters.source)" :src="sourceImg(filters.source)" class="social-imgs" />
                <b-avatar v-else text="All" size="35" style="background-color: #fed16e; color:#4c412d;"></b-avatar>
            </div>
            <b-form-select class="pf-source" id="priority-source-select" v-model="filters.source"
                :options="sourceOptions"></b-form-select>
            <b-input-group class="pf-follower">
                <template #prepend>
                    <span style="background: #fed16e;" class="input-group-text">ค้นหาจำนวนผู้ติดตาม</span>
                </template>
                <b-form-select id="priority-follower-select" v-model="followers"
                    :options="followerOptions" @change="onFilterChange"></b-form-select>
            </b-input-group>
            <b-input-group class="pf-search">
                <b-form-input id="search-priority" @input="checkSearch" v-model="search"
                    placeholder="ค้นหาเป้าหมาย"></b-form-input>
                <b-input-group-append>
                    <b-button variant="info" :pressed="false" @click="onSearch()" class="px-4">ค้นหา</b-button>
                </b-input-group-append>
            </b-input-group>
        </div>

        <!-- backend-offline notice -->
        <b-alert :show="backendOffline" variant="warning" class="d-flex align-items-center">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            <span>ยังเชื่อมต่อระบบเป้าหมายพิเศษไม่ได้ (backend อาจยังไม่ขึ้น server) — แสดงผลในโหมดตัวอย่าง</span>
        </b-alert>

        <div class="boxlist-card py-3">
            <br>
            <vue-element-loading :active="load" size="80" background-color="rgba(255, 255, 255, 0.3)" color="#ede7dd" />

            <b-table
                v-if="data.length !== 0"
                :items="data || []"
                :fields="fields"
                hover responsive show-details
                :busy="load"
                thead-class="d-none"
                stacked="md"
                empty-filtered-text="ไม่พบข้อมูล"
            >
                <template #cell(id)="row">
                    {{ row.index + 1 + (currentPage - 1) * perPage }}
                </template>

                <template #cell(name)="row">
                    <div class="d-flex justify-content-start align-items-center">
                        <span class="mr-2">
                            <span style="position: absolute;">
                                <b-avatar icon="lightning-charge-fill" size="20" class="icon-bolt"></b-avatar>
                            </span>
                            <b-avatar :src="row.item.profile_image" class="avatar-priority-border"></b-avatar>
                        </span>
                        <div class="text-truncate target-name" style="max-width: 220px; cursor: pointer;"
                            @click="linkToProfile(row.item)" v-b-tooltip.hover title="ดูรายละเอียด">
                            <div class="d-flex align-items-center">
                                <span class="bold">{{ row.item.name || row.item.uid }}</span>
                            </div>
                            <small class="text-muted">ผู้ติดตาม {{ formatNumber(row.item.followers) }}</small>
                        </div>
                    </div>
                </template>

                <template #cell(source)="row">
                    <div class="small d-flex align-items-center pr-0 w-auto bg-link">
                        <img v-if="sourceImg(row.item.source)" :src="sourceImg(row.item.source)" class="social-img" />
                        <a :href="row.item.link_original" target="_blank" class="mx-2 text-truncate d-inline-block"
                            style="color: #2c3e50 !important;">
                            {{ row.item.uid }}
                        </a>
                    </div>
                </template>

                <template #cell(insert_timestamp)="row">
                    <span class="small">{{ formatDate(row.item.insert_timestamp) }}</span>
                </template>

                <template #cell(action)="row">
                    <b-row cols="2" class="m-0 justify-content-end align-items-center flex-nowrap">
                        <b-col cols="auto" class="p-0">
                            <span class="fas fa-list-ul text-info px-2" v-b-tooltip.hover
                                title="ดูรายละเอียด" style="cursor:pointer;"
                                @click="linkToProfile(row.item)"></span>
                        </b-col>
                        <b-col cols="auto" class="p-0">
                            <span class="fas fa-user-alt-slash text-danger px-2" v-b-tooltip.hover
                                title="เลิกติดตาม" style="cursor:pointer;"
                                @click="delTarget(row.item)"></span>
                        </b-col>
                    </b-row>
                </template>
            </b-table>

            <!-- empty state -->
            <div v-if="data.length === 0 && !load" class="text-center text-muted py-5">
                <i class="fas fa-bolt" style="font-size: 36px; color:#fed16e;"></i>
                <div class="mt-3">ยังไม่มีเป้าหมายพิเศษ</div>
                <small>กด “เพิ่มเป้าหมายพิเศษ” เพื่อเริ่มเก็บข้อมูลแบบพิเศษ (สูงสุด {{ maxTargets }} บัญชี)</small>
            </div>

            <!-- pagination -->
            <div class="d-flex justify-content-center mt-3" v-if="totalRows > perPage">
                <b-pagination v-model="currentPage" :total-rows="totalRows" :per-page="perPage"
                    @change="onPageChange" align="center" first-number last-number></b-pagination>
            </div>
        </div>
    </div>
</template>

<script>
import Swal from 'sweetalert2';
import 'sweetalert2/dist/sweetalert2.min.css';
import CreateMonitor from "@/components/monitorlist/CreateMonitor.vue";

const API_BASE = "https://api2.cognizata.com/api/v2/monitor";

export default {
    name: "MonitorPriorityTable",
    components: { CreateMonitor },
    props: {
        type: { type: String, default: "monitorlist" },
        reface: { type: [Boolean, Number], default: false }
    },
    data() {
        return {
            maxTargets: 20,
            load: false,
            backendOffline: false,
            data: [],
            totalRows: 0,
            search: "",
            debounceTimeout: null,
            currentPage: 1,
            perPage: 20,
            filters: { source: "" },
            followers: null,
            sourceOptions: [
                { value: '', text: 'All Platform' },
                { value: 'facebook', text: 'Facebook' },
                { value: 'twitter', text: 'X' },
                { value: 'pantip', text: 'Board' },
                { value: 'news', text: 'News' },
                { value: 'youtube', text: 'YouTube' },
                { value: 'instagram', text: 'Instagram' },
                { value: 'blockdit', text: 'Blockdit' },
                { value: 'tiktok', text: 'Tiktok' },
                { value: 'threads', text: 'Threads' }
            ],
            followerOptions: [
                { value: null, text: 'ไม่ระบุ' },
                { value: 1000, text: 'มากกว่า 1,000 follower' },
                { value: 10000, text: 'มากกว่า 10,000 follower' },
                { value: 100000, text: 'มากกว่า 100,000 follower' },
                { value: 1000000, text: 'มากกว่า 1,000,000 follower' }
            ],
            fields: [
                { key: 'id', label: '#' },
                { key: 'name', label: 'name' },
                { key: 'source', label: 'source' },
                { key: 'insert_timestamp', label: 'เวลาล่าสุด' },
                { key: 'action', label: '' }
            ],
            sourceImages: {
                facebook: require('@/assets/Facebook.png'),
                twitter: require('@/assets/Twitter.png'),
                pantip: require('@/assets/board.png'),
                blockdit: require('@/assets/Blockdit.png'),
                instagram: require('@/assets/Instagram.png'),
                youtube: require('@/assets/Youtube.png'),
                news: require('@/assets/News.png'),
                tiktok: require('@/assets/Tiktok.png'),
                threads: require('@/assets/Threads.png')
            }
        };
    },
    computed: {
        // โควตาที่เหลือ ใช้ cap จำนวนที่เพิ่มได้ในแต่ละครั้ง (existing + new <= maxTargets)
        remainingQuota() {
            return Math.max(0, this.maxTargets - this.totalRows);
        }
    },
    watch: {
        reface() { this.apiMonitorList(); },
        type() {
            this.data = [];
            this.totalRows = 0;
            this.currentPage = 1;
            this.apiMonitorList();
        },
        "filters.source"() {
            this.currentPage = 1;
            this.apiMonitorList();
        }
    },
    methods: {
        authHeaders() {
            return {
                Authorization: "Bearer " + localStorage.getItem("token"),
                "Content-Type": "application/json"
            };
        },
        sourceImg(source) {
            return this.sourceImages[source] || null;
        },
        formatNumber(num) {
            if (num == null) return '0';
            if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
            if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
            return num.toString();
        },
        formatDate(dateStr) {
            if (!dateStr) return '-';
            const date = new Date(dateStr);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            let hours = date.getHours();
            const minutes = String(date.getMinutes()).padStart(2, '0');
            const seconds = String(date.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12;
            return `${day}/${month}/${year} , ${hours}:${minutes}:${seconds} ${ampm}`;
        },
        checkSearch() {
            if (!this.search) this.apiMonitorList();
        },
        onSearch() {
            clearTimeout(this.debounceTimeout);
            this.debounceTimeout = setTimeout(() => {
                this.currentPage = 1;
                this.apiMonitorList();
            }, 500);
        },
        // เปลี่ยน filter จำนวนผู้ติดตาม -> รีเซ็ตหน้าแล้วโหลดใหม่
        onFilterChange() {
            this.currentPage = 1;
            this.apiMonitorList();
        },
        onPageChange(page) {
            this.currentPage = page;
            this.$nextTick(() => this.apiMonitorList());
        },
        // CreateMonitor emit('close') หลังเพิ่มสำเร็จ -> รีโหลดลิสต์ + โควตา
        onAdded() {
            this.currentPage = 1;
            this.apiMonitorList();
            this.$emit('setReface');
        },

        // GET /api/v2/monitor/getMonitor?type=monitorlist
        apiMonitorList() {
            this.load = true;
            const requestId = (this._requestId || 0) + 1;
            this._requestId = requestId;

            const config = {
                method: "get",
                url: `${API_BASE}/getMonitor`,
                params: {
                    type: this.type || 'monitorlist',
                    page: this.currentPage,
                    limit: this.perPage,
                    search: this.search,
                    ...(this.filters.source && { source: this.filters.source }),
                    ...(this.followers != null && { followers: this.followers })
                },
                headers: this.authHeaders()
            };

            this.axios(config)
                .then((response) => {
                    if (requestId !== this._requestId) return;
                    const resData = response.data || {};
                    this.data = resData.data || [];
                    this.totalRows = resData.pagination?.totalCount ?? this.data.length;
                    this.backendOffline = false;
                    this.load = false;
                })
                .catch((error) => {
                    if (requestId !== this._requestId) return;
                    this.load = false;
                    this.data = [];
                    this.totalRows = 0;
                    // backend ยังไม่พร้อม (type ใหม่ยังไม่ขึ้น server) -> โหมดตัวอย่าง
                    this.backendOffline = true;
                    console.warn("[Priority] getMonitor unavailable:", error?.response?.status || error?.message);
                });
        },

        // เปิดหน้ารายละเอียดเหมือนโปรไฟล์ target ปกติ (เปิดแท็บใหม่)
        linkToProfile(item) {
            const routeData = this.$router.resolve({
                name: "MonitorProfile",
                query: {
                    id: item._id,
                    uid: item.uid ? item.uid.replace('#', '') : item.uid,
                    source: item.source,
                    type: 'targetlist'
                },
            });
            window.open(routeData.href, "_blank");
        },

        // DELETE /api/v2/monitor/removeTargetMonitor
        delTarget(item) {
            Swal.fire({
                title: 'คุณแน่ใจหรือไม่?',
                text: 'ต้องการเลิกติดตามเป้าหมายพิเศษนี้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'ใช่, เลิกติดตาม!',
                cancelButtonText: 'ยกเลิก',
                customClass: { confirmButton: 'btn btn-success', cancelButton: 'btn btn-danger' },
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                if (!result.isConfirmed) return;
                const config = {
                    method: "delete",
                    url: `${API_BASE}/removeTargetMonitor`,
                    data: { target_ids: [item._id] },
                    headers: this.authHeaders()
                };
                this.axios(config)
                    .then(() => {
                        this.apiMonitorList();
                        this.$emit('setReface');
                        Swal.fire({ title: 'สำเร็จ', text: 'เลิกติดตามเรียบร้อยแล้ว', icon: 'success', timer: 2000, showConfirmButton: false });
                    })
                    .catch((error) => {
                        console.error("[Priority] removeTargetMonitor:", error);
                        Swal.fire('ผิดพลาด', 'ไม่สามารถเลิกติดตามได้', 'error');
                    });
            });
        }
    },
    mounted() {
        this.apiMonitorList();
    }
};
</script>

<style scoped>
* { font-family: "Prompt", "FontAwesome", sans-serif; }

.quota-pill {
    display: inline-flex;
    align-items: center;
    background: #fff4d6;
    color: #4c412d;
    border: 1px solid #fed16e;
    border-radius: 999px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 15px;
}
.quota-pill.full {
    background: #fde2e2;
    border-color: #e57373;
    color: #b23b3b;
}

.btn-add-priority {
    border: 0;
    background: #fed16e;
    color: #4c412d;
    font-weight: 600;
    font-size: 15px;
    padding: 8px 18px;
    border-radius: 8px;
    box-shadow: rgba(0, 0, 0, 0.12) 0px 3px 8px;
    white-space: nowrap;
}
.btn-add-priority:disabled { opacity: .5; cursor: not-allowed; }

.social-img { width: 22px; height: 22px; object-fit: contain; }
.social-imgs { width: 35px; height: 35px; object-fit: contain; }

.icon-bolt {
    position: relative;
    z-index: 2;
    left: -7px;
    background-color: #fed16e;
    color: #4c412d;
}
.avatar-priority-border {
    border: 3px solid transparent;
    border-radius: 50%;
    background-image: linear-gradient(#fed16e, #fed16e), linear-gradient(135deg, #fed16e, #e0a93c);
    background-origin: border-box;
    background-clip: content-box, border-box;
}

.boxlist-card {
    background: #fff;
    border-radius: 12px;
    position: relative;
    min-height: 200px;
}
.bg-link { background: transparent; }
.bold { font-weight: 600; }

.priority-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}
.priority-header-actions { gap: 12px; }
.priority-header-actions .pf-add,
.priority-header-actions .btn-add-priority {
    flex: 0 0 auto;
    min-width: 190px;
}

.priority-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}
.pf-source-icon { flex: 0 0 auto; display: flex; align-items: center; }
.pf-source { flex: 1 1 180px; max-width: 240px; }
.pf-follower { flex: 2 1 300px; }
.pf-search { flex: 2 1 260px; }
.pf-follower .input-group-text { white-space: nowrap; }

@media (max-width: 767px) {
    .priority-header-actions { width: 100%; }
    .pf-source { max-width: none; }
}
</style>
